<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        style="@style/Widget.UPI.TopBar">

        <ImageButton
            android:id="@+id/btnBackChapterAdd"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/tvChapterAddTitle"
            style="@style/Widget.UPI.TopBarTitle"
            android:text="Add transactions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmChapterAdd"
            style="@style/Widget.UPI.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChapterAddRange"
        style="@style/Widget.UPI.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Last 90 days" />

    <TextView
        android:id="@+id/tvChapterAddEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nothing here to add.\n\nOnly untagged transactions involving a member, or none of your friends at all, can go into a chapter."
        android:textAlignment="center"
        android:textColor="?attr/appTextMuted"
        android:textSize="13sp"
        android:paddingTop="28dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChapterAdd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false" />
</LinearLayout>
