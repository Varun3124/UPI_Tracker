<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        style="@style/Widget.UPI.TopBar">

        <ImageButton
            android:id="@+id/btnBackChapterDetail"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/tvChapterDetailTitle"
            style="@style/Widget.UPI.TopBarTitle"
            android:text="Chapter" />

        <ImageButton
            android:id="@+id/btnChapterOverflow"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/cd_chapter_overflow" />
    </LinearLayout>

    <!-- Fixed header: what this chapter is, above whichever page is showing. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:id="@+id/tvChapterDetailState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.UPI.Label" />

        <CheckBox
            android:id="@+id/switchChapterActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add new transactions to this chapter" />
    </LinearLayout>

    <!-- The two sub-pages, splitting the panel's width equally. Headings rather than pills, the
         same as the dashboard's IOU slider and Statistics' two sections: a pill reads as a filter. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.UPI.SectionTab.Split"
            android:id="@+id/btnChapterTransactions"
            android:text="Transactions" />

        <TextView
            style="@style/Widget.UPI.SectionTab.Split"
            android:id="@+id/btnChapterBalances"
            android:text="Balances" />
    </LinearLayout>

    <!-- Only one page is ever visible, so whichever it is takes the whole weight. -->
    <LinearLayout
        android:id="@+id/chapterTransactionsPage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Who and where, chosen from what this chapter actually holds rather than typed: a chapter
             is a small, known set of people and places, so a list beats a search box. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_s">

            <TextView
                style="@style/Widget.UPI.Pill"
                android:id="@+id/btnChapterFriendFilter"
                android:ellipsize="end"
                android:maxWidth="140dp"
                android:singleLine="true"
                android:textSize="12sp" />

            <TextView
                style="@style/Widget.UPI.Pill"
                android:id="@+id/btnChapterMerchantFilter"
                android:layout_marginStart="@dimen/space_s"
                android:ellipsize="end"
                android:maxWidth="140dp"
                android:singleLine="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvChapterFilterHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.UPI.Label" />

            <!-- On the list's own row, since adding is something done to the list. Hidden while the
                 chapter is closed. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddChapterTransactions"
                style="@style/Widget.UPI.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="Add" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChapterTransactionsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:text="Nothing tagged here yet."
            android:textColor="?attr/appTextMuted"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChapterTransactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="@dimen/space_m" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chapterBalancesPage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chapterBalancesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s" />
    </ScrollView>

    <include layout="@layout/view_selection_bar" />
</LinearLayout>
