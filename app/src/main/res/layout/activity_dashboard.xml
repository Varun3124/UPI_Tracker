<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Top bar. Not @style/Widget.UPI.TopBar: this is the one screen with no back arrow, so it
         sits on the page rather than on a raised surface. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/page_gutter">

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/cd_settings" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.UPI.TitleLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddManual"
            style="@style/Widget.UPI.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add"
            android:contentDescription="@string/cd_add_transaction"
            app:icon="@drawable/ic_add"
            app:iconGravity="start" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_xxl">

            <!-- Spending. The one card carrying the accent fill, so the eye lands here first. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpending"
                style="@style/Widget.UPI.Card.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_l">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Spending"
                            android:textAppearance="@style/TextAppearance.UPI.SectionHeader"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.75" />

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_insights"
                            app:tint="?attr/colorOnPrimaryContainer"
                            android:alpha="0.6"
                            android:contentDescription="@string/cd_statistics" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today"
                                android:textAppearance="@style/TextAppearance.UPI.Label"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:alpha="0.7" />

                            <TextView
                                android:id="@+id/tvDailySpend"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.UPI.Amount.Medium"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeMaxTextSize="20sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_marginEnd="@dimen/space_s"
                            android:background="?attr/colorOnPrimaryContainer"
                            android:alpha="0.2" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This week"
                                android:textAppearance="@style/TextAppearance.UPI.Label"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:alpha="0.7" />

                            <TextView
                                android:id="@+id/tvWeeklySpend"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.UPI.Amount.Medium"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeMaxTextSize="20sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_marginEnd="@dimen/space_s"
                            android:background="?attr/colorOnPrimaryContainer"
                            android:alpha="0.2" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This month"
                                android:textAppearance="@style/TextAppearance.UPI.Label"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:alpha="0.7" />

                            <TextView
                                android:id="@+id/tvMonthlySpend"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.UPI.Amount.Medium"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeMaxTextSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:text="Recent"
                android:textAppearance="@style/TextAppearance.UPI.SectionHeader" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/recentTransactionsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:text="IOU"
                android:textAppearance="@style/TextAppearance.UPI.SectionHeader" />

            <LinearLayout
                android:id="@+id/iouContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleInsignificantIou"
                style="@style/Widget.UPI.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="Show insignificant"
                android:textColor="?attr/appTextMuted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
