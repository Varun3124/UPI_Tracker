<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar -->
    <LinearLayout
        style="@style/Widget.UPI.TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <TextView
            style="@style/Widget.UPI.TopBarTitle"
            android:id="@+id/tvFriendDetailName" />

        <TextView
            android:id="@+id/tvFriendDetailBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Same control, same three gestures as All Transactions; see MonthRangeControl. -->
        <TextView
            android:id="@+id/btnPickMonth"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Whether this friend is linked to a DhanMoney account. Tapping it links, manages or fixes it. -->
    <LinearLayout
        android:id="@+id/rowLinkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/space_s"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/space_m"
            android:src="@drawable/ic_link"
            app:tint="?attr/colorOnSurfaceVariant"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvLinkStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.UPI.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLinkAction"
            style="@style/Widget.UPI.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- The balance agreed with them, and any proposal about it waiting on either side. -->
    <LinearLayout
        android:id="@+id/rowAgreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/space_s"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/space_m"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorOnSurfaceVariant"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvAgreementStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.UPI.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgreementAction"
            style="@style/Widget.UPI.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- The personal half of the headline balance, and one row per chapter making up the rest. -->
    <TextView
        android:id="@+id/tvFriendPersonalBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.UPI.Caption"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/friendChapterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_s" />

    <include layout="@layout/view_search_row" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFriendTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <include layout="@layout/view_selection_bar" />
</LinearLayout>
