<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant all three permissions below to continue."
        android:textSize="16sp"
        android:gravity="center"
        android:paddingBottom="40dp"/>

    <Button
        android:id="@+id/btnGrantSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant SMS Permission"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:enabled="false"/>

    <TextView
        android:id="@+id/tvPendingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No pending transactions"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#E65100"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"/>

    <Button
        android:id="@+id/btnManualEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Manual Transaction"
        android:layout_marginTop="8dp"/>

</LinearLayout>