<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/statsTopBar"
        style="@style/Widget.UPI.TopBar">

        <ImageButton
            android:id="@+id/btnBackStats"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <TextView
            style="@style/Widget.UPI.TopBarTitle"
            android:text="Statistics" />

        <!-- Same shape and styling as btnPickMonth on All Transactions: flat, not a pill. -->
        <TextView
            android:id="@+id/btnPickPeriod"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The two sections, splitting the width equally. Headings rather than pills, the same as the
         dashboard's IOU slider and a chapter's two pages: a pill reads as a filter. -->
    <LinearLayout
        android:id="@+id/sectionTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.UPI.SectionTab.Split"
            android:id="@+id/btnSectionCategories"
            android:text="Categories" />

        <TextView
            style="@style/Widget.UPI.SectionTab.Split"
            android:id="@+id/btnSectionTrends"
            android:text="Trends" />
    </LinearLayout>

    <!-- Categories only: Trends has no period, since its graph zooms to whatever span it is shown. -->
    <LinearLayout
        android:id="@+id/periodRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnPrevPeriod"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/cd_previous_period" />

        <TextView
            android:id="@+id/tvRangeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNextPeriod"
            style="@style/Widget.UPI.IconButton"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/cd_next_period" />
    </LinearLayout>

    <!-- Wraps the Categories scroller only, so a horizontal drag anywhere over its charts steps
         the period while vertical drags still scroll. Trends is a SIBLING of this rather than a
         child: this container decides the gesture axis in onInterceptTouchEvent, and a chart that
         pans horizontally could never win a drag from inside it. -->
    <com.varun.upitracker.ui.statistics.SwipeableFrameLayout
        android:id="@+id/swipeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/statsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCategoryCardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.1"
                            android:text="BY CATEGORY"
                            android:textColor="?attr/appTextMuted"
                            android:textSize="11sp" />

                        <!-- Only visible while drilled into a category. -->
                        <TextView
                            android:id="@+id/btnClearDrill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="Show all ✕"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.varun.upitracker.ui.statistics.PieChartView
                            android:id="@+id/pieChart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!-- The centre figure is a real TextView so it formats like every other
                             amount in the app; the chart itself draws no text. -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Categorised"
                                android:textColor="?attr/appTextMuted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPieTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPiePerDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/appTextMuted"
                                android:textSize="11sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="No spending in this period"
                        android:textColor="?attr/appTextMuted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/legendContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardWeekBars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="PER DAY"
                        android:textColor="?attr/appTextMuted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPeakDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="?attr/appTextMuted"
                        android:textSize="12sp" />

                    <com.varun.upitracker.ui.statistics.StackedBarChartView
                        android:id="@+id/weekBars"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    </com.varun.upitracker.ui.statistics.SwipeableFrameLayout>

    <!-- Only one of the two sections is ever visible, so whichever it is takes the whole weight.
         Trends is the graph and nothing else, edge to edge, with its few controls floating on it the
         way Desmos keeps its own; it is not in a ScrollView, so every drag is the graph's. -->
    <FrameLayout
        android:id="@+id/trendsPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <com.varun.upitracker.ui.statistics.BalanceGraphView
            android:id="@+id/balanceGraph"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Which accounts, and what they hold now. The scope picker sits here because it scopes
             the whole graph; Categories' totals carry no account, so it has none. -->
        <LinearLayout
            android:id="@+id/trendsOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_variant_rounded"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/btnPickScope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="28dp"
                android:gravity="center_vertical"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- A real TextView so it formats like every other amount in the app. -->
            <TextView
                android:id="@+id/tvBalanceLatest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Shown only while part of the line is a reconstruction, so the brown and the dashed
                 mark are not left to be guessed at. -->
            <TextView
                android:id="@+id/tvSpeculationNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:textColor="?attr/appSpeculative"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Home, closer and further, as Desmos keeps beside its graph. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_surface_variant_rounded"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnGraphHome"
                style="@style/Widget.UPI.IconButton"
                android:src="@drawable/ic_home"
                android:contentDescription="Back to the last month, or everything since the first balance snapshot" />

            <ImageButton
                android:id="@+id/btnGraphZoomIn"
                style="@style/Widget.UPI.IconButton"
                android:src="@drawable/ic_add"
                android:contentDescription="Zoom in" />

            <ImageButton
                android:id="@+id/btnGraphZoomOut"
                style="@style/Widget.UPI.IconButton"
                android:src="@drawable/ic_remove"
                android:contentDescription="Zoom out" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTrendsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="?attr/appTextMuted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
