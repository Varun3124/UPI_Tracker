<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <EditText
            android:id="@+id/etAccountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Account label *"
            android:inputType="textCapWords"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spAccountType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etInitialBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Initial balance (e.g. 1234.56)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etSnapshotEpoch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Snapshot date &amp; time"
            android:focusable="false"
            android:clickable="true"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRemoveRow"
        style="@style/Widget.UPI.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="@dimen/space_s"
        android:src="@drawable/ic_close"
        app:tint="?attr/appNegative"
        android:contentDescription="@string/cd_remove" />
</LinearLayout>
