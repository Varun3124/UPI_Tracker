<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shareRowCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_surface_variant_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvShareAvatar"
        style="@style/Widget.UPI.Avatar.Small"
        android:contentDescription="@string/cd_avatar" />

    <AutoCompleteTextView
        android:id="@+id/etShareName"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@null"
        android:completionThreshold="1"
        android:hint="Alias"
        android:imeOptions="actionDone"
        android:inputType="textCapWords"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/appTextMuted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etShareAmount"
        android:layout_width="91dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@null"
        android:gravity="end"
        android:hint="0"
        android:imeOptions="actionDone"
        android:inputType="numberDecimal"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/appTextMuted"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/btnRemoveShare"
        style="@style/Widget.UPI.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="@dimen/space_s"
        android:src="@drawable/ic_close"
        app:tint="?attr/appNegative"
        android:contentDescription="@string/cd_remove" />
</LinearLayout>
