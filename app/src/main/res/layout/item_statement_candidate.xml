<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCandidate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCandidateName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvCandidateAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvCandidateDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/appTextMuted" />

            <TextView
                android:id="@+id/tvCandidateAliasHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Name matches the statement"
                android:textSize="11sp"
                android:textColor="?attr/colorSecondary"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tvCandidateCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorOnPrimary"
            android:background="@drawable/bg_circle"
            android:backgroundTint="?attr/appPositive"
            android:contentDescription="@string/cd_selected"
            android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
