<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.UPI.Card.Clickable"
    android:layout_width="@dimen/recent_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <TextView
            android:id="@+id/tvPendingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_s"
            android:background="@drawable/bg_badge"
            android:backgroundTint="?attr/appWarning"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="PENDING"
            android:textAppearance="@style/TextAppearance.UPI.Label"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCardPayee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.UPI.Body"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCardAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.UPI.Amount.Medium" />

        <TextView
            android:id="@+id/tvCardDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.UPI.Label" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
