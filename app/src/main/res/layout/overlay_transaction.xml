<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/accent_black"
    android:padding="16dp">

    <!-- Section 1: FRIEND toggle + Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

    <ToggleButton
        android:id="@+id/btnFriendToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOn="FRIEND ✓"
        android:textOff="FRIEND"
        android:checked="false"
        android:textSize="13sp"
        android:backgroundTint="@color/compliment_cyan"
        android:textColor="@color/white"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:background="@null"/>
    </LinearLayout>

    <!-- Category chips (visible in merchant mode only) -->
    <LinearLayout
        android:id="@+id/categorySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="6dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#444444" android:layout_marginBottom="12dp"/>

    <!-- Section 2: Direction label + Alias + Amount -->
    <TextView
        android:id="@+id/tvDirection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etAlias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Payee name / alias"
        android:inputType="textCapWords"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:textColorHint="#888888"
        android:layout_marginBottom="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@null"
            android:inputType="numberDecimal"
            android:hint="0.00"
            android:textColorHint="#44FFFFFF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Section 3: Friends row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friends involved"
        android:textSize="12sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/friendsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp"/>
    </HorizontalScrollView>


    <!-- Done + Custom Split -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <Button
        android:id="@+id/btnDone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="DONE"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/compliment_cyan"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/btnCustomSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom Split"
        android:backgroundTint="@color/compliment_cyan"
        android:textColor="@color/white"/>
    </LinearLayout>

</LinearLayout>