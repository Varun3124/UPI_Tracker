<?xml version="1.0" encoding="utf-8"?>
<!--
  Named "overlay" for historical reasons - it began as the SMS overlay and is now the full-screen
  transaction entry Activity, still launched over the lock screen by OverlayService.

  It used to be hardcoded dark while every other screen was hardcoded light. It follows the theme
  now, so it is navy in dark mode and light in light mode like everything else.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_gutter"
            android:paddingBottom="220dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTopInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.UPI.Label" />

                <ImageButton
                    android:id="@+id/btnClose"
                    style="@style/Widget.UPI.IconButton"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/appTextMuted"
                    android:contentDescription="@string/cd_close" />
            </LinearLayout>

            <!-- ===================== Payer ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.UPI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Payer"
                            android:textAppearance="@style/TextAppearance.UPI.Title"
                            android:textSize="14sp" />

                        <!-- Styled by styleActorTiles(): it sets isSelected/isEnabled and the pill
                             selector drawable does the rest. -->
                        <LinearLayout
                            android:id="@+id/payerActorTiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPayerActorMe"
                                style="@style/Widget.UPI.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/pill_height"
                                android:minWidth="52dp"
                                android:text="Me"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPayerActorFriend"
                                style="@style/Widget.UPI.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/pill_height"
                                android:layout_marginStart="@dimen/space_xs"
                                android:minWidth="52dp"
                                android:text="Friend"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPayerActorMerchant"
                                style="@style/Widget.UPI.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/pill_height"
                                android:layout_marginStart="@dimen/space_xs"
                                android:minWidth="52dp"
                                android:text="Merchant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/payerSharesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPayerPerson"
                        style="@style/Widget.UPI.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="Add person"
                        android:textSize="12sp"
                        android:contentDescription="@string/cd_add_person"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="start"
                        app:iconSize="16dp" />

                    <TextView
                        android:id="@+id/tvPayerBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.UPI.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Amount ===================== -->
            <LinearLayout
                android:id="@+id/amountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹"
                    android:textAppearance="@style/TextAppearance.UPI.Amount.Hero"
                    android:textColor="?attr/colorPrimary" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="0.00"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textAppearance="@style/TextAppearance.UPI.Amount.Hero"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/appTextMuted"
                    android:autofillHints="" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEqualize"
                    style="@style/Widget.UPI.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:text="Equalize"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===================== Date ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.UPI.Card.Clickable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m">

                <LinearLayout
                    android:id="@+id/dateSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:layout_marginEnd="@dimen/space_l"
                        android:src="@drawable/ic_calendar"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textAppearance="@style/TextAppearance.UPI.Label" />

                        <TextView
                            android:id="@+id/tvDateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.UPI.Body" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/etDescription"
                style="@style/Widget.UPI.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:hint="Description"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top|start"
                android:autofillHints="" />

            <!-- ===================== Payee ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.UPI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Payee"
                            android:textAppearance="@style/TextAppearance.UPI.Title"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/payeeActorTiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPayeeActorMe"
                                style="@style/Widget.UPI.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/pill_height"
                                android:minWidth="52dp"
                                android:text="Me"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPayeeActorFriend"
                                style="@style/Widget.UPI.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/pill_height"
                                android:layout_marginStart="@dimen/space_xs"
                                android:minWidth="52dp"
                                android:text="Friend"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPayeeActorMerchant"
                                style="@style/Widget.UPI.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/pill_height"
                                android:layout_marginStart="@dimen/space_xs"
                                android:minWidth="52dp"
                                android:text="Merchant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/payeeSharesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPayeePerson"
                        style="@style/Widget.UPI.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="Add person"
                        android:textSize="12sp"
                        android:contentDescription="@string/cd_add_person"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="start"
                        app:iconSize="16dp" />

                    <TextView
                        android:id="@+id/tvPayeeBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.UPI.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Ledger options ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ledgerOptionsCard"
                style="@style/Widget.UPI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:id="@+id/ledgerEffectSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This money"
                            android:textAppearance="@style/TextAppearance.UPI.Title"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvLedgerEffectToggle"
                            style="@style/Widget.UPI.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:minHeight="@dimen/pill_height"
                            android:paddingTop="@dimen/space_s"
                            android:paddingBottom="@dimen/space_s"
                            android:text="Doesn&apos;t affect what we owe each other"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/refundSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Refund for"
                            android:textAppearance="@style/TextAppearance.UPI.Title"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvRefundTarget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="Not a refund - counts as income"
                            android:textAppearance="@style/TextAppearance.UPI.Body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                android:text="Unallocated"
                android:textAppearance="@style/TextAppearance.UPI.Caption" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginBottom="@dimen/space_m"
                android:background="?attr/colorOutlineVariant" />

            <HorizontalScrollView
                android:id="@+id/categoryScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="200dp"
                    app:alignItems="flex_start"
                    app:flexDirection="column"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start" />

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            style="@style/Widget.UPI.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done" />
    </LinearLayout>

</LinearLayout>
