<?xml version="1.0" encoding="utf-8"?>
<!--
  The search box shared by All Transactions and a friend's page, plus the "n of m" count.

  A plain EditText rather than a SearchView: the app has no ActionBar menu anywhere, and a SearchView
  brings its own hint, icon and collapse behaviour that would match nothing else on these screens.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_s">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="@dimen/space_s"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_search"
        app:tint="?attr/appTextMuted" />

    <EditText
        android:id="@+id/etTxSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/hint_search_transactions"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="@dimen/touch_target_min"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/appTextMuted"
        android:textSize="14sp" />

    <!-- Shown only while there is something to clear. -->
    <ImageButton
        android:id="@+id/btnClearSearch"
        style="@style/Widget.UPI.IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="@dimen/space_s"
        android:contentDescription="@string/cd_clear_search"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:tint="?attr/appTextMuted" />

    <TextView
        android:id="@+id/tvFilterHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.UPI.Label" />
</LinearLayout>
