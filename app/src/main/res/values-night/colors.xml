<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Semantic tokens - DARK. Every name here must also exist in values/colors.xml; the pair is
      what makes light/dark work, and a name present in only one file silently reads the wrong
      colour in the other mode.

      The navy family carries the surfaces here (deepest at the page, lifting toward the cards)
      and the peach becomes the accent, which is the arrangement the palette was built for.
    -->
    <color name="app_background">@color/brand_navy_900</color>
    <color name="app_surface">@color/brand_navy_800</color>
    <color name="app_surface_variant">@color/brand_navy_600</color>
    <color name="app_surface_elevated">#2E3A5A</color>
    <color name="app_outline">#454F6E</color>
    <color name="app_outline_variant">#313B57</color>

    <color name="app_on_surface">#EDEFF7</color>
    <color name="app_on_surface_variant">#A9B2CC</color>
    <color name="app_on_surface_muted">#79839E</color>

    <color name="app_primary">@color/brand_peach</color>
    <color name="app_on_primary">@color/brand_navy_900</color>
    <color name="app_primary_container">@color/brand_maroon</color>
    <color name="app_on_primary_container">#FDC7AE</color>

    <color name="app_secondary">#A9B6DE</color>
    <color name="app_on_secondary">#181A2F</color>
    <color name="app_secondary_container">@color/brand_navy_600</color>
    <color name="app_on_secondary_container">#DFE3F1</color>

    <color name="app_positive">#4FC9A0</color>
    <color name="app_negative">#F0697D</color>
    <color name="app_warning">#F0B366</color>
    <color name="app_amount_neutral">#79839E</color>

    <color name="app_negative_container">@color/brand_maroon</color>
    <color name="app_on_negative_container">#FFD7DC</color>
    <color name="app_positive_container">#12483A</color>
    <color name="app_on_positive_container">#B4EBD6</color>

    <color name="app_avatar_me">@color/brand_peach</color>
    <color name="app_on_avatar_me">@color/brand_navy_900</color>
    <color name="app_avatar_friend">#7A87B0</color>
    <color name="app_on_avatar_friend">@color/brand_navy_900</color>
    <color name="app_avatar_merchant">#B8607C</color>
    <color name="app_on_avatar_merchant">@color/brand_navy_900</color>

    <color name="app_chart_grid">#2E3A5A</color>
    <color name="app_chart_zero_line">#454F6E</color>
    <color name="app_chart_axis_label">#79839E</color>
    <color name="app_chart_track">#222C46</color>
    <color name="app_chart_neutral">#566082</color>


</resources>
